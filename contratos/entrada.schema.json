{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financiera-saludable.local/entrada.schema.json",
  "title": "Entrada del clasificador de transacciones",
  "$defs": {
    "transaccion": {
      "type": "object",
      "required": ["descripcion", "valor", "fecha"],
      "properties": {
        "descripcion": {"type": "string", "minLength": 1},
        "valor": {"type": "number"},
        "fecha": {
          "type": "string",
          "oneOf": [
            {"format": "date"},
            {"format": "date-time"}
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/transaccion"},
    {
      "type": "object",
      "required": ["transacciones"],
      "properties": {
        "transacciones": {
          "type": "array",
          "items": {"$ref": "#/$defs/transaccion"}
        }
      },
      "additionalProperties": true
    }
  ]
}

