{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://financiera-saludable.local/salida.schema.json",
  "title": "Salida del clasificador de transacciones",
  "$defs": {
    "clasificacion": {
      "type": "object",
      "required": ["categoria", "confiabilidad"],
      "properties": {
        "categoria": {
          "type": "string",
          "enum": [
            "ALIMENTACION",
            "APORTE_INVERSIONES",
            "EDUCACION",
            "GASTOS_HORMIGA",
            "INGRESOS",
            "OCIO",
            "OTROS",
            "SALUD",
            "SERVICIOS",
            "SUSCRIPCIONES",
            "TRANSPORTE",
            "VIVIENDA"
          ]
        },
        "confiabilidad": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/clasificacion"},
    {
      "type": "object",
      "required": ["transacciones"],
      "properties": {
        "transacciones": {
          "type": "array",
          "items": {"$ref": "#/$defs/clasificacion"}
        }
      },
      "additionalProperties": false
    }
  ]
}

