# BACKEND_URL: URL del backend Spring Boot al que se reenvían las llamadas /api.
# Opcional en local (default: http://localhost:8080). OBLIGATORIA en producción.
BACKEND_URL="http://localhost:8080"

# PORT: puerto del servidor Express. Opcional (default: 3000).
# Las plataformas de hosting suelen inyectarlo automáticamente.
PORT=3000
